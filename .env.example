# ==============================================================================
# SatPrep - Bank Exam Quant & Aptitude Test Platform
# Environment Configuration Template
# ==============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required for PostgreSQL, Authentication, Real-time and Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Google Gemini API
# Required for question blueprints, twist generation, OCR extraction and blind re-solve
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_REASONING=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Python Worker Service
# Background question generation, sandbox solver verification & test bundle assembler
# ------------------------------------------------------------------------------
WORKER_URL=http://localhost:8000
WORKER_API_SECRET=satprep_worker_secret_key_change_in_production

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay - P1 Subscriptions)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# Test Engine & Timing Rules
# ------------------------------------------------------------------------------
# Grace seconds allowed for clock skew & late submissions before discard
TEST_GRACE_PERIOD_SECONDS=3
# Attempts threshold before empirical difficulty replaces assigned difficulty
EMPIRICAL_CALIBRATION_THRESHOLD=30
# Auto-flag question report threshold
AUTO_FLAG_REPORT_THRESHOLD=3
# Ready test expiration in days
TEST_EXPIRATION_DAYS=7
