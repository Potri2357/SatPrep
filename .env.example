# ==============================================================================
# SatPrep - Bank Exam Quant & Aptitude Test Platform
# Environment Configuration Template (Vercel & Local Development)
# ==============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL=https://your-deployment-subdomain.vercel.app
NODE_ENV=production

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required for PostgreSQL, Authentication, Real-time and Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transaction Pooler connection string for Serverless (Vercel):
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# Google Gemini API
# Multi-model cascade support with automated failover & key rotation
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_BACKUP=your-backup-gemini-api-key
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay - P1 Subscriptions)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# Test Engine & Timing Rules
# ------------------------------------------------------------------------------
TEST_GRACE_PERIOD_SECONDS=3
EMPIRICAL_CALIBRATION_THRESHOLD=30
AUTO_FLAG_REPORT_THRESHOLD=3
TEST_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# React Bits Pro Registry (Optional)
# ------------------------------------------------------------------------------
REACTBITS_LICENSE_KEY=your_reactbits_license_key_here
